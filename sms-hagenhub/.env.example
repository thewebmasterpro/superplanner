# SMS-HagenHub Configuration
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090

# SMS Provider (configure your provider)
SMS_PROVIDER=twilio
SMS_API_KEY=your_api_key_here
SMS_API_SECRET=your_api_secret_here
SMS_FROM_NUMBER=+491234567890

# Rate Limiting
SMS_RATE_LIMIT_PER_MINUTE=60
SMS_RATE_LIMIT_PER_DAY=1000

# Logging
LOG_LEVEL=info
